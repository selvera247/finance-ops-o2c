# Gemini API (Google AI Studio) — local ADK runs
GOOGLE_API_KEY=

# Or use Vertex AI instead of AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Model override
FINANCE_OPS_MODEL=gemini-flash-latest

# Data plane: fixtures | warehouse (DuckDB, default for E2E) | bigquery
FINANCE_OPS_DATA_MODE=warehouse

# Legacy flag still honored if DATA_MODE unset
FINANCE_OPS_USE_BIGQUERY=false
FINANCE_OPS_BQ_DATASET=finance_ops

# Optional Vertex Vector Search switch (local hash embeddings by default)
FINANCE_OPS_USE_VERTEX_VECTORS=false
