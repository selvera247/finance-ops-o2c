# Gemini API (Google AI Studio) — local ADK runs
GOOGLE_API_KEY=

# Or use Vertex AI instead of AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Model override
FINANCE_OPS_MODEL=gemini-flash-latest

# BigQuery adapter (fixture mode is default)
FINANCE_OPS_USE_BIGQUERY=false
FINANCE_OPS_BQ_DATASET=finance_ops
