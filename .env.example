GOOGLE_API_KEY=
FINANCE_OPS_MODEL=gemini-3.1-flash-lite
FINANCE_OPS_DATA_MODE=warehouse
FINANCE_OPS_USE_BIGQUERY=false
GOOGLE_CLOUD_PROJECT=
FINANCE_OPS_BQ_DATASET=finance_ops
FINANCE_OPS_USE_VERTEX_VECTORS=false
FINANCE_OPS_VERTEX_LOCATION=us-central1
FINANCE_OPS_EMBEDDING_MODEL=text-embedding-004
FINANCE_OPS_VECTOR_INDEX_ENDPOINT=
FINANCE_OPS_VECTOR_DEPLOYED_INDEX_ID=finance_ops_policies
FINANCE_OPS_GRAPH_BACKEND=duckdb
SPANNER_INSTANCE=
SPANNER_DATABASE=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=financeops
FINANCE_OPS_SERVE_MODE=http
LEGACY_PORTAL_USER=analyst
LEGACY_PORTAL_PASS=demo123
SLACK_WEBHOOK_URL=
HITL_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Cloud Run free wedge: public GETs; writes need Bearer / X-API-Token
FINANCE_OPS_API_TOKEN=
FINANCE_OPS_GOVERNANCE_TOKEN=
FINANCE_OPS_LOCK_WRITES=
# Copilot MVP prototype flags (see docs/copilot-mvp.md)
# Modes A–D: workbench+email0 | workbench+email1 | slack_contrast | rules_only
COPILOT_MODE=workbench
COPILOT_EMAIL_EVIDENCE=0
# Email mailbox: fixture (CI) or imap when credentials set
COPILOT_MAILBOX_BACKEND=
COPILOT_MAILBOX_FIXTURE=
COPILOT_ACTOR_ACL_PATH=
# COPILOT_ACTOR_CUSTOMERS=pilot:C-1042,C-4417;reviewer:*
COPILOT_IMAP_HOST=
COPILOT_IMAP_USER=
COPILOT_IMAP_PASSWORD=
COPILOT_IMAP_FOLDER=INBOX
COPILOT_IMAP_PORT=993
# Remittance PDF/OCR (fixtures under data/copilot/remittance/)
COPILOT_REMITTANCE_EXTRACT=1
COPILOT_REMITTANCE_DIR=
COPILOT_OCR_PROVIDER=auto
# Optional digest — OFF by default (alert fatigue). Send stub is a second gate.
COPILOT_DIGEST_ENABLED=0
COPILOT_DIGEST_SEND=0
COPILOT_DIGEST_MIN_CONFIDENCE=medium
COPILOT_DIGEST_EXCLUDE_INSUFFICIENT=1
COPILOT_DIGEST_MAX_ITEMS=25
COPILOT_DIGEST_EMAIL_TO=
# Quarantine warehouse apply on Copilot path (default off = guidance-only)
FINANCE_OPS_DEMO_APPLY=0
